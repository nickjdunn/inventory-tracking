; Force-remove Merlin Inventory when reinstall fails or the app is stuck.
; Tap on deploy page — exit the native app first (Set → Exit app).
[Version]
Signature="$Windows NT$"
Provider="Merlin Inventory"
CESignature="$Windows CE$"
MajorVersion=1
MinorVersion=0

[CEStrings]
AppName="Merlin Inventory"
InstallDir=%CE1%\MerlinInventory

[CEDevice]
VersionMin=6.0
VersionMax=6.99

[CEDevice.ARMV4I]

[DefaultInstall]
CopyFiles=Files.App

[DefaultUninstall]
DelFiles=Files.App
DelShortcuts=Shortcuts

[SourceDisksNames]
1=,"Merlin Inventory Remove",,.

[SourceDisksFiles]
MerlinInventoryTest.exe=1

[DestinationDirs]
Files.App=0,%InstallDir%
Shortcuts=0,%CE14%

[Files.App]
MerlinInventoryTest.exe,,,0

[Shortcuts]
Merlin Inventory,0,MerlinInventoryTest.exe,%CE14%
Merlin Inv,0,MerlinInventoryTest.exe,%CE2%
