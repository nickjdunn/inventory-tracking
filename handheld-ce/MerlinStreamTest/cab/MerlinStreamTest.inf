; Merlin Stream Test — direct server stream, no local logs
[Version]
Signature="$Windows NT$"
Provider="Merlin Stream Test"
CESignature="$Windows CE$"
MajorVersion=1
MinorVersion=0

[CEStrings]
AppName="Merlin Stream"
InstallDir=%CE1%\MerlinStream

[Strings]

[CEDevice]
VersionMin=6.0
VersionMax=6.99

[DefaultInstall]
CopyFiles=Files.App
CEShortcuts=Shortcuts

[DefaultUninstall]
DelFiles=Files.App
DelShortcuts=Shortcuts

[SourceDisksNames]
1=,"Merlin Stream",,.

[SourceDisksFiles]
MerlinStreamTest.exe=1

[DestinationDirs]
Files.App=0,%InstallDir%
Shortcuts=0,%CE14%

[Files.App]
MerlinStreamTest.exe,,,0

[Shortcuts]
Merlin Stream,0,MerlinStreamTest.exe,%CE14%
